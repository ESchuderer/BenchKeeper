{
  "name": "benchkeeper",
  "initializeCommand": [
    "sh",
    "-c",
    "set -e; common=$(cd \"$(git rev-parse --git-common-dir)\" && pwd); printf 'WORKSPACE=%s\\nGIT_COMMON=%s\\n' \"$PWD\" \"$common\" > .devcontainer/.env"
  ],
  "dockerComposeFile": "compose.yaml",
  "service": "app",
  "workspaceFolder": "${localWorkspaceFolder}",
  "remoteUser": "node",
  "updateRemoteUserUID": false
}
