{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "import", "promise", "node", "vitest"],
  "categories": { "correctness": "error", "suspicious": "error" },
  "options": { "typeAware": true, "denyWarnings": true, "reportUnusedDisableDirectives": "error" },
  "ignorePatterns": ["**/dist/**", "packages/*/schema/**"],
  "rules": {
    "complexity": ["error", 10],
    "max-depth": ["error", 3],
    "max-lines-per-function": ["error", { "max": 50, "skipBlankLines": true, "skipComments": true }],
    "max-params": ["error", 4],
    "no-nested-ternary": "error",
    "no-else-return": "error",
    "no-lonely-if": "error",
    "no-unneeded-ternary": "error",
    "no-useless-return": "error",
    "no-useless-catch": "error",
    "prefer-const": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unnecessary-boolean-literal-compare": "error",
    "typescript/no-unnecessary-type-parameters": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-explicit-any": "error",
    "typescript/ban-ts-comment": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": ["error", { "allow": ["**/*.css", "**/jitless.ts"] }]
  },
  "overrides": [
    {
      "files": ["packages/contracts/src/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "window",
              "document",
              "navigator",
              "location",
              "localStorage",
              "sessionStorage",
              "fetch",
              "XMLHttpRequest",
              "indexedDB",
              "globalThis",
              "self"
            ],
            "checkGlobalObject": true
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@cedarloom/*"],
                "message": "contracts depend on no runtime and no other CedarLoom package"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/agent-contracts/src/**", "packages/adapter-*/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cedarloom/*", "!@cedarloom/contracts", "!@cedarloom/agent-contracts"],
                "message": "the agent contract and the adapters depend on the contracts only, never on each other"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/accounts/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@cedarloom/*", "!@cedarloom/contracts"],
                "message": "accounts is a pure domain package (D2): the contracts and zod only, no Node and no other package"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/client/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@cedarloom/contracts",
                "message": "the client runs in the browser: import @cedarloom/contracts/http, the root brings zod"
              }
            ],
            "patterns": [
              {
                "group": [
                  "node:*",
                  "@cedarloom/use-cases",
                  "@cedarloom/server",
                  "@cedarloom/engine",
                  "@cedarloom/ledger"
                ],
                "message": "the client runs in the browser: no Node module, directly or through a Node-only package"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/cli/src/**", "packages/server/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@cedarloom/engine", "@cedarloom/ledger"],
                "message": "the CLI and the server reach the engine and the run store only through @cedarloom/use-cases"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/ui/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@cedarloom/engine",
                "message": "the engine's root carries Node code; the browser takes @cedarloom/engine/graph or /validate"
              }
            ],
            "patterns": [
              {
                "group": ["node:*", "@cedarloom/ledger", "@cedarloom/use-cases", "@cedarloom/server"],
                "message": "the web UI runs in the browser and reaches the server through @cedarloom/client"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/engine/src/validate.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["node:*", "@cedarloom/ledger", "./**", "../**", "!./graph.ts"],
                "message": "the editor loads the validator in the browser: it takes the contracts and the graph module only"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["packages/engine/src/graph.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["*"],
                "allowTypeImports": true,
                "message": "the graph module runs in the browser: it takes types from the contracts, no zod and no Node"
              }
            ]
          }
        ]
      }
    }
  ]
}
