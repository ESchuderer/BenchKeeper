{
  "name": "benchkeeper",
  "version": "6.26.0",
  "description": "Installs, updates and undoes the BenchKeeper agent setup, globally and per project, for Claude Code, Codex, Gemini CLI and GitHub Copilot.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "benchkeeper": "bin/benchkeeper.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "content"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESchuderer/BenchKeeper.git",
    "directory": "app"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --import ./test/setup.mjs --test test/*.test.mjs",
    "test:coverage": "node --import ./test/setup.mjs --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"ui/*.js\" --test-coverage-exclude=ui/api.js --test-coverage-lines=99 --test-coverage-branches=92 --test-coverage-functions=96 --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=lcov.info test/*.test.mjs && node scripts/quality.mjs coverage lcov.info",
    "test:ui": "playwright test",
    "prepack": "node scripts/content.mjs && vite build",
    "postpack": "node scripts/content.mjs --clean",
    "check:imports": "node scripts/imports.mjs",
    "check:baselines": "node scripts/quality.mjs baselines",
    "mutate": "stryker run",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/charts": "9.7.3",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/spotlight": "9.7.3",
    "@playwright/test": "1.64.1",
    "@stryker-mutator/core": "10.0.0",
    "@tabler/icons-react": "3.49.0",
    "@vitejs/plugin-react": "6.1.2",
    "dependency-cruiser": "18.7.0",
    "jscpd": "5.4.2",
    "knip": "6.42.1",
    "postcss": "8.5.31",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "vite": "8.3.5"
  },
  "overrides": {
    "qs": "6.16.1"
  }
}
