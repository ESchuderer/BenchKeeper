{
  "name": "benchkeeper",
  "version": "6.5.0",
  "description": "Installs, updates and undoes the BenchKeeper agent setup, globally and per project, for Claude Code, Codex, Gemini CLI and GitHub Copilot.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "benchkeeper": "bin/benchkeeper.mjs"
  },
  "files": [
    "bin",
    "src",
    "dist",
    "content"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ESchuderer/BenchKeeper.git",
    "directory": "app"
  },
  "scripts": {
    "build": "vite build",
    "test": "node --test test/*.test.mjs",
    "test:ui": "playwright test",
    "prepack": "node scripts/content.mjs && vite build",
    "postpack": "node scripts/content.mjs --clean",
    "smoke": "node scripts/smoke.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "smol-toml": "1.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/inter": "5.3.0",
    "@mantine/charts": "9.7.3",
    "@mantine/core": "9.7.3",
    "@mantine/hooks": "9.7.3",
    "@mantine/spotlight": "9.7.3",
    "@playwright/test": "1.64.1",
    "@tabler/icons-react": "3.49.0",
    "@vitejs/plugin-react": "6.1.2",
    "postcss": "8.5.30",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-is": "19.3.1",
    "recharts": "3.10.1",
    "vite": "8.3.4"
  }
}
