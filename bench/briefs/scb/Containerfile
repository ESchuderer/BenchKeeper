# Scorer image for the SlopCodeBench step briefs: the harness (slop-code eval-snapshot, local environment) and scb-check,
# both pinned. podman build -t benchkeeper-scb bench/briefs/scb
FROM ghcr.io/astral-sh/uv@sha256:9711d0538671a400b1f95707636c1bff1553403e4b805f23008b5b610a995f8c
RUN apt-get update && apt-get install -y --no-install-recommends git jq && rm -rf /var/lib/apt/lists/* \
  && uv tool install "git+https://github.com/SprocketLab/slop-code-bench@31ceea3add480edb33431e70475c4c70597e6b31" \
  && uv tool install scb-check==0.1.3 \
  && git clone -q https://github.com/SprocketLab/slop-code-bench /opt/scb && git -C /opt/scb checkout -q 31ceea3add480edb33431e70475c4c70597e6b31
# Reference HTTP responses use the system MIME database, including image/webp.
RUN apt-get update && apt-get install -y --no-install-recommends media-types && rm -rf /var/lib/apt/lists/*
# scb-check runs ast-grep as `sg` from PATH, where /usr/bin/sg (login) would answer and its rules would be skipped silently.
RUN ln -s "$(uv tool dir)/scb-check/bin/sg" /usr/local/bin/sg
ENV PATH=/root/.local/bin:$PATH
