# Agent image for one benchmark arm. Build context: the repository root.
# podman build -f bench/image/Containerfile --build-arg ARM=<A to H> -t benchkeeper-arm-<arm> .
FROM docker.io/library/node:22.23.3-bookworm-slim@sha256:efd0ab5780c2d9ab1f0f869571a00d5edb17793bff4cce4a2792e3eb0ffc7562
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates jq && rm -rf /var/lib/apt/lists/*
RUN npm i -g @anthropic-ai/claude-code@2.1.299
ENV DISABLE_AUTOUPDATER=1 PATH=/home/node/.local/bin:$PATH
COPY rules/global.md bench/arms/base.rules.md bench/arms/candidate.rules.md bench/image/install-arm.sh /opt/bench/
COPY skills /opt/bench/skills
COPY bench/arms/project-setup /opt/bench/project-setup
ARG ARM
# Arms C, D, E: system libraries for the project's Playwright MCP browser (version of @playwright/mcp@0.0.83).
RUN if [ "$ARM" = C ] || [ "$ARM" = D ] || [ "$ARM" = E ]; then npx -y playwright-core@1.64.0-alpha-1790635538000 install-deps chromium && rm -rf /var/lib/apt/lists/* /root/.npm; fi
USER node
WORKDIR /home/node
RUN /opt/bench/install-arm.sh "$ARM"
# Other arms' rules and skills must not be readable by this arm's agent.
USER root
RUN rm -rf /opt/bench
USER node
