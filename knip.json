{
  "$schema": "./node_modules/knip/schema.json",
  "github-actions": { "config": [".github/workflows/cedarloom.yml"] },
  "ignoreBinaries": ["mkfifo"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.test.ts"],
      "project": ["*.ts", "scripts/*.ts"],
      "node": false,
      "ignoreDependencies": ["@mantine/mcp-server"]
    },
    "packages/*": { "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "test/**/*.ts"] },
    "packages/extension-host": {
      "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["@types/node-forge"]
    }
  }
}
