{
  "name": "@cedarloom/accounts",
  "version": "0.0.0",
  "private": true,
  "description": "The account domain of CedarLoom: the registry of config folders, pools and minimums, and the launch-time choice of an account.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:"
  }
}
