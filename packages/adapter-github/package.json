{
  "name": "@cedarloom/adapter-github",
  "version": "0.0.0",
  "private": true,
  "description": "The GitHub adapter of CedarLoom's work items: the tracker port on the hub's issues through GitHub's REST API.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/work-items": "workspace:*",
    "@octokit/core": "7.0.8",
    "@octokit/plugin-paginate-rest": "16.0.0",
    "zod": "catalog:"
  }
}
