{
  "name": "@cedarloom/agent-contracts",
  "version": "0.0.0",
  "private": true,
  "description": "The contract every CedarLoom agent adapter implements: start, observe, cancel, resume and hand over sessions, report capabilities and usage readings.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*"
  }
}
