{
  "name": "@cedarloom/cli",
  "version": "0.0.0",
  "private": true,
  "description": "The cedarloom and cloom commands.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "cedarloom": "./src/bin.ts",
    "cloom": "./src/bin.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "bin": {
      "cedarloom": "./dist/bin.js",
      "cloom": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "extensions"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/adapter-claude": "workspace:*",
    "@cedarloom/adapter-github": "workspace:*",
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/server": "workspace:*",
    "@cedarloom/ui": "workspace:*",
    "@cedarloom/use-cases": "workspace:*",
    "@commander-js/extra-typings": "15.0.0",
    "@napi-rs/keyring": "2.1.2",
    "commander": "15.0.0"
  },
  "devDependencies": {
    "@cedarloom/ledger": "workspace:*",
    "zod": "catalog:"
  }
}
