{
  "schemaVersion": 1,
  "kind": "cedarloom.workflow",
  "metadata": {
    "id": "report-only-write",
    "name": "A scheduled workflow that writes a file",
    "version": "1.0.0"
  },
  "nodes": [
    {
      "id": "notes",
      "type": "file.write",
      "with": {
        "path": "notes/nightly.md"
      }
    },
    {
      "id": "start",
      "type": "trigger.schedule",
      "with": {
        "cron": "0 3 * * *",
        "precheck": "test -f notes/todo.md"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "start",
        "handle": "start"
      },
      "to": {
        "node": "notes",
        "handle": "run"
      }
    }
  ]
}
