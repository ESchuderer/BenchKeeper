{
  "schemaVersion": 1,
  "kind": "cedarloom.workflow",
  "metadata": {
    "id": "build-notes",
    "name": "Build notes",
    "version": "1.0.0"
  },
  "inputs": {
    "publish": {
      "type": "boolean",
      "default": false
    }
  },
  "nodes": [
    {
      "id": "ask",
      "type": "human.approval",
      "with": {
        "gate": "merge",
        "message": "Publish the notes?"
      }
    },
    {
      "id": "build",
      "type": "command.run",
      "with": {
        "command": "pnpm build"
      }
    },
    {
      "id": "gate",
      "type": "condition"
    },
    {
      "id": "lint",
      "type": "command.run",
      "with": {
        "command": "pnpm lint"
      }
    },
    {
      "id": "merge",
      "type": "join",
      "with": {
        "policy": "all"
      }
    },
    {
      "id": "notes",
      "type": "agent.run",
      "with": {
        "effort": "high",
        "model": "opus",
        "skill": "build-notes",
        "task": "Write the build notes from the build output.",
        "tools": [
          "Read",
          "Write"
        ]
      }
    },
    {
      "id": "start",
      "type": "trigger.manual"
    },
    {
      "id": "test",
      "type": "command.run",
      "with": {
        "command": "pnpm test",
        "role": "check"
      }
    }
  ],
  "edges": [
    {
      "id": "e1",
      "from": {
        "node": "start",
        "handle": "start"
      },
      "to": {
        "node": "build",
        "handle": "run"
      }
    },
    {
      "id": "e12",
      "from": {
        "node": "notes",
        "handle": "done"
      },
      "to": {
        "node": "test",
        "handle": "run"
      }
    },
    {
      "id": "e2",
      "from": {
        "node": "start",
        "handle": "start"
      },
      "to": {
        "node": "lint",
        "handle": "run"
      }
    },
    {
      "id": "e3",
      "from": {
        "node": "build",
        "handle": "done"
      },
      "to": {
        "node": "merge",
        "handle": "branches"
      }
    },
    {
      "id": "e4",
      "from": {
        "node": "lint",
        "handle": "done"
      },
      "to": {
        "node": "merge",
        "handle": "branches"
      }
    },
    {
      "id": "e5",
      "from": {
        "node": "merge",
        "handle": "done"
      },
      "to": {
        "node": "gate",
        "handle": "run"
      }
    },
    {
      "id": "e6",
      "from": {
        "input": "publish"
      },
      "to": {
        "node": "gate",
        "handle": "value"
      }
    },
    {
      "id": "e7",
      "from": {
        "node": "gate",
        "handle": "true"
      },
      "to": {
        "node": "ask",
        "handle": "run"
      }
    },
    {
      "id": "e8",
      "from": {
        "node": "ask",
        "handle": "approved"
      },
      "to": {
        "node": "notes",
        "handle": "run"
      }
    },
    {
      "id": "e9",
      "from": {
        "node": "build",
        "handle": "stdout"
      },
      "to": {
        "node": "notes",
        "handle": "context"
      }
    }
  ],
  "execution": {
    "failurePolicy": "continue_independent"
  }
}
