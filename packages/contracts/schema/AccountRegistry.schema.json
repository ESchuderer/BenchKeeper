{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AccountRegistry.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "minimum": {
      "type": "object",
      "properties": {
        "fiveHour": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "sevenDay": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "fiveHour",
        "sevenDay"
      ],
      "additionalProperties": false
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
          },
          "agent": {
            "type": "string",
            "enum": [
              "claude",
              "codex"
            ]
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "home": {
            "type": "string",
            "pattern": "^(\\/|[A-Za-z]:[\\\\/]|\\\\\\\\)",
            "description": "The account's config folder (CLAUDE_CONFIG_DIR or CODEX_HOME); its login stays there"
          },
          "pool": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "minimum": {
            "description": "The account's own minimums, in place of the registry's",
            "type": "object",
            "properties": {
              "fiveHour": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "sevenDay": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            },
            "additionalProperties": false
          },
          "added": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "name",
          "agent",
          "home",
          "pool",
          "added"
        ],
        "additionalProperties": false
      }
    },
    "pools": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "enum": [
          "claude",
          "codex"
        ]
      },
      "additionalProperties": {
        "type": "object",
        "propertyNames": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
        },
        "additionalProperties": {
          "type": "object",
          "properties": {
            "confirmedAt": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                },
                {
                  "type": "null"
                }
              ],
              "description": "When the user confirmed that one person holds and pays for every account of the pool; null: no switching"
            },
            "confirmedFor": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
              },
              "description": "The accounts the confirmation named; once the pool's accounts differ, it counts as unconfirmed"
            }
          },
          "required": [
            "confirmedAt",
            "confirmedFor"
          ],
          "additionalProperties": false
        }
      }
    }
  },
  "required": [
    "schemaVersion",
    "minimum",
    "accounts",
    "pools"
  ],
  "additionalProperties": false
}
