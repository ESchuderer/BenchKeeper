{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "AgentSession.schema.json",
  "type": "object",
  "properties": {
    "agent": {
      "type": "string",
      "enum": [
        "claude-code",
        "codex"
      ]
    },
    "id": {
      "type": "string"
    },
    "project": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": [
        "string",
        "null"
      ]
    },
    "start": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "end": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "busyMs": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "costUSD": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "costEstimated": {
      "type": "boolean"
    },
    "unpriced": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tests": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "pass",
            "fail"
          ]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "agent",
    "id",
    "project",
    "title",
    "start",
    "end",
    "busyMs",
    "tokens",
    "costUSD",
    "costEstimated",
    "unpriced",
    "tests"
  ],
  "additionalProperties": false
}
