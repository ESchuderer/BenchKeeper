{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CommandRunConfig.schema.json",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B\\u200E\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u2069\\uFEFF\\uFFF9-\\uFFFB\\u200C\\u200D]*$"
    },
    "cwd": {
      "description": "The project folder when absent",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?![\\s\\S]*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
    },
    "role": {
      "description": "check: the agent step before it cannot end while the command fails; step when absent",
      "type": "string",
      "enum": [
        "step",
        "check"
      ]
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false
}
