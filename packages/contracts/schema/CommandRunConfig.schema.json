{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "CommandRunConfig.schema.json",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "cwd": {
      "description": "The project folder when absent",
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!(?:.*\\/)?\\.\\.(?:\\/|$))[^\\\\]+$"
    }
  },
  "required": [
    "command"
  ],
  "additionalProperties": false
}
