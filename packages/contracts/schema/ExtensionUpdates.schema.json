{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ExtensionUpdates.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds this JSON Schema; readers ignore it",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.extension-updates"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "ExtensionId.schema.json"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "The commit, never a branch or tag that can move"
          },
          "seen": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
            "description": "When this machine first fetched that commit at the ref"
          }
        },
        "required": [
          "commit",
          "seen"
        ],
        "additionalProperties": false
      },
      "maxProperties": 500
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "extensions"
  ],
  "additionalProperties": false
}
