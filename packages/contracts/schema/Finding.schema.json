{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "Finding.schema.json",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "document.newer-schema"
        },
        "params": {
          "type": "object",
          "properties": {
            "found": {
              "$ref": "SchemaVersion.schema.json"
            },
            "known": {
              "$ref": "SchemaVersion.schema.json"
            }
          },
          "required": [
            "found",
            "known"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "params"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "const": "document.invalid"
        },
        "params": {
          "type": "object",
          "properties": {
            "issues": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string"
                  },
                  "code": {
                    "type": "string"
                  }
                },
                "required": [
                  "path",
                  "code"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "issues"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "code",
        "params"
      ],
      "additionalProperties": false
    }
  ]
}
