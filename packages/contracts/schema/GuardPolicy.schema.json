{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "GuardPolicy.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "repositories": {
      "type": "string",
      "const": "origin",
      "description": "The repositories of the working folder's origin, read when the hook runs, besides the hub and memory"
    },
    "hub": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}\\/(?!\\.{1,2}$)[A-Za-z0-9._-]{1,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "memory": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]{1,39}\\/(?!\\.{1,2}$)[A-Za-z0-9._-]{1,100}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "merge": {
      "description": "workflow (Auto): a merge from an agent of a workflow script, which a stage reaches only after its reviewer agreed; refuse when absent",
      "type": "string",
      "enum": [
        "refuse",
        "workflow"
      ]
    },
    "plugin": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "The package's plugin, whose steps' own subagents (<plugin>:<step>) meet the guard"
    }
  },
  "required": [
    "schemaVersion",
    "repositories",
    "hub",
    "memory",
    "plugin"
  ],
  "additionalProperties": false
}
