{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "HumanApprovalConfig.schema.json",
  "type": "object",
  "properties": {
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B\\u200E\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u2069\\uFEFF\\uFFF9-\\uFFFB]*$"
    },
    "gate": {
      "description": "The level's gate this is: it stops where the level keeps it (Supervised all three, Checkpoint merge, Auto none), and at every level when absent",
      "type": "string",
      "enum": [
        "implementation",
        "verdict",
        "merge"
      ]
    }
  },
  "required": [
    "message"
  ],
  "additionalProperties": false
}
