{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "InstalledExtensions.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds this JSON Schema; readers ignore it",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.extensions"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "ExtensionId.schema.json"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)\\.(?:0|[1-9]\\d*)(?:-(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*)?$"
          },
          "source": {
            "type": "object",
            "properties": {
              "git": {
                "type": "string",
                "maxLength": 2048,
                "pattern": "^(?:https:\\/\\/|ssh:\\/\\/|[A-Za-z0-9_][A-Za-z0-9._-]*@[A-Za-z0-9])[!-[\\]-~]*$",
                "description": "An https or ssh Git URL, or user@host:path; no password, no user over https, no user or host starting with -, no query or fragment, nothing percent-encoded below space or above ~"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "The commit, never a branch or tag that can move"
              },
              "path": {
                "description": "The extension's folder inside the repository; its root when absent",
                "type": "string",
                "maxLength": 1024,
                "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]{0,254}(?:\\/[A-Za-z0-9._][A-Za-z0-9._-]{0,254})*$"
              }
            },
            "required": [
              "git",
              "commit"
            ],
            "additionalProperties": false
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the folder's listing at the commit: per file one line `<mode> <SHA-256 of the file> <path>` ending in \\n, the mode 100644 or 100755, the path relative to the folder; the lines in the byte order of the paths"
          },
          "ref": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,254}$",
            "description": "The branch or tag an update follows; HEAD for the repository's default branch"
          },
          "consented": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the canonical JSON of the capabilities the user approved; an update that asks for more asks again"
          }
        },
        "required": [
          "version",
          "source",
          "digest",
          "ref",
          "consented"
        ],
        "additionalProperties": false
      },
      "maxProperties": 500
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "extensions"
  ],
  "additionalProperties": false
}
