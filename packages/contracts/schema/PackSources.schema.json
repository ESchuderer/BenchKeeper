{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PackSources.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds this JSON Schema; readers ignore it",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.pack-sources"
    },
    "sources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 2048
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "The commit, never a branch or tag that can move"
          },
          "digest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "SHA-256 of the folder's listing at the commit: per file one line `<mode> <SHA-256 of the file> <path>` ending in \\n, the mode 100644 or 100755, the path relative to the folder; the lines in the byte order of the paths"
          },
          "seen": {
            "type": "object",
            "properties": {
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$",
                "description": "The commit, never a branch or tag that can move"
              },
              "at": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
              }
            },
            "required": [
              "commit",
              "at"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "commit",
          "digest",
          "seen"
        ],
        "additionalProperties": false
      },
      "maxProperties": 500
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "sources"
  ],
  "additionalProperties": false
}
