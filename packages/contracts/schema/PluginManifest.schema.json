{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "PluginManifest.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds this JSON Schema; readers ignore it",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.plugin"
    },
    "id": {
      "$ref": "PluginId.schema.json"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "description": {
      "type": "string",
      "maxLength": 2000,
      "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
    },
    "license": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9.+():-]+(?: [A-Za-z0-9.+():-]+)*$",
      "description": "SPDX license expression"
    },
    "api": {
      "type": "string",
      "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}$",
      "description": "The plugin protocol version it needs: the same major version, at least this minor one"
    },
    "runtime": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "node"
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "allOf": [
            {
              "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?![\\s\\S]*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
            },
            {
              "pattern": "\\.[cm]?js$"
            }
          ],
          "description": "The script the host starts, inside the plugin's folder"
        }
      },
      "required": [
        "kind",
        "entry"
      ],
      "additionalProperties": false
    },
    "platforms": {
      "description": "Where it runs; every platform when absent",
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "darwin",
          "linux",
          "win32"
        ]
      },
      "uniqueItems": true
    },
    "capabilities": {
      "description": "None when absent",
      "type": "object",
      "properties": {
        "net": {
          "description": "Hosts the plugin may call through the host's fetch, and no others",
          "maxItems": 32,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^https:\\/\\/[a-z0-9][a-z0-9.-]*(?::[1-9][0-9]{0,4})?$"
          },
          "uniqueItems": true
        },
        "credentials": {
          "description": "Credential types the plugin uses; it never receives their values",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "description": {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
              },
              "scheme": {
                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "http"
                      },
                      "scheme": {
                        "type": "string",
                        "enum": [
                          "bearer",
                          "basic"
                        ]
                      }
                    },
                    "required": [
                      "type",
                      "scheme"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "apiKey"
                      },
                      "in": {
                        "type": "string",
                        "const": "header"
                      },
                      "name": {
                        "type": "string",
                        "pattern": "^[A-Za-z0-9-]{1,64}$"
                      }
                    },
                    "required": [
                      "type",
                      "in",
                      "name"
                    ],
                    "additionalProperties": false
                  }
                ],
                "description": "The host refuses a request in which the plugin sets this header itself"
              },
              "hosts": {
                "minItems": 1,
                "maxItems": 32,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 300,
                  "pattern": "^https:\\/\\/[a-z0-9][a-z0-9.-]*(?::[1-9][0-9]{0,4})?$"
                },
                "uniqueItems": true,
                "description": "The host adds the credential to requests to these hosts only; each is in `net`"
              }
            },
            "required": [
              "scheme",
              "hosts"
            ],
            "additionalProperties": false
          },
          "maxProperties": 16
        },
        "projectRead": {
          "description": "Reads project files through the host",
          "type": "boolean"
        },
        "planWrite": {
          "description": "Proposes file writes, which apply only through a plan the user approves",
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "contributes": {
      "type": "object",
      "properties": {
        "actions": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
              },
              "description": {
                "type": "string",
                "maxLength": 2000,
                "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
              },
              "config": {
                "description": "JSON Schema 2020-12 of the node's `with`: a `$ref` points inside it (`#...`), no `$id`, no other `$schema`",
                "anyOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "$ref": "JsonValue.schema.json"
                    }
                  }
                ]
              },
              "inputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "allOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    {
                      "pattern": "^(?!run$)"
                    }
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "$ref": "DataType.schema.json"
                    },
                    "required": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000,
                      "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                "maxProperties": 32
              },
              "outputs": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "allOf": [
                    {
                      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
                    },
                    {
                      "pattern": "^(?!(?:done|failed)$)"
                    }
                  ]
                },
                "additionalProperties": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "$ref": "DataType.schema.json"
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 2000,
                      "pattern": "^[^\\p{Cc}\\u061C\\u200E\\u200F\\u202A-\\u202E\\u2066-\\u2069]*$"
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                "maxProperties": 32
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "minProperties": 1,
          "maxProperties": 100
        }
      },
      "required": [
        "actions"
      ],
      "additionalProperties": false
    },
    "catalogs": {
      "description": "Translations of its texts by language; English is the manifest's own",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1024,
        "allOf": [
          {
            "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?![\\s\\S]*(?:^|\\/)\\.\\.(?:\\/|$))[^\\\\]+$"
          },
          {
            "pattern": "\\.po$"
          }
        ]
      },
      "maxProperties": 100
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "id",
    "version",
    "name",
    "api",
    "runtime",
    "contributes"
  ],
  "additionalProperties": false,
  "description": "A CedarLoom plugin manifest; readers also refuse values nested over 32 levels deep"
}
