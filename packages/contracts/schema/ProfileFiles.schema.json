{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ProfileFiles.schema.json",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Where an editor finds this JSON Schema; readers ignore it",
      "type": "string"
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.profile-files"
    },
    "files": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "maxLength": 1024,
        "pattern": "^[A-Za-z0-9._][A-Za-z0-9._-]{0,254}(?:\\/[A-Za-z0-9._][A-Za-z0-9._-]{0,254})*$",
        "description": "Portable names joined by /: no .git, no trailing dot, no Windows device name such as CON or COM1"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "pack": {
            "description": "The pack its text came from, as `id@version`: a pack id and its SemVer version",
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}\\.[a-z][a-z0-9-]{0,63}@\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
          }
        },
        "required": [
          "sha256"
        ],
        "additionalProperties": false
      },
      "maxProperties": 2000
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "files"
  ],
  "additionalProperties": false
}
