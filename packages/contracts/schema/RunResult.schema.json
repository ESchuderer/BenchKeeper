{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RunResult.schema.json",
  "type": "object",
  "properties": {
    "runId": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "applied",
        "failed",
        "refused",
        "nothing-to-undo"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "Finding.schema.json"
      }
    }
  },
  "required": [
    "runId",
    "status",
    "findings"
  ],
  "additionalProperties": false
}
