{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "RunsEvent.schema.json",
  "type": "object",
  "properties": {
    "runs": {
      "type": "array",
      "items": {
        "$ref": "Run.schema.json"
      }
    },
    "graphRuns": {
      "type": "array",
      "items": {
        "$ref": "GraphRunSummary.schema.json"
      }
    }
  },
  "required": [
    "runs",
    "graphRuns"
  ],
  "additionalProperties": false
}
