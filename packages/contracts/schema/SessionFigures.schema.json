{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SessionFigures.schema.json",
  "type": "object",
  "properties": {
    "sessions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "busyMs": {
      "type": "number",
      "minimum": 0
    },
    "costUSD": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "null"
        }
      ]
    },
    "uncosted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tokens": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "daysWorked": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "streak": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tested": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "testsPassed": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "sessions",
    "busyMs",
    "costUSD",
    "uncosted",
    "tokens",
    "days",
    "daysWorked",
    "streak",
    "tested",
    "testsPassed"
  ],
  "additionalProperties": false
}
