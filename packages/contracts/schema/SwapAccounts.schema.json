{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "SwapAccounts.schema.json",
  "type": "object",
  "properties": {
    "accounts": {
      "type": "array",
      "items": {
        "$ref": "SwapAccount.schema.json"
      }
    },
    "settings": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "accounts",
    "settings"
  ],
  "additionalProperties": false
}
