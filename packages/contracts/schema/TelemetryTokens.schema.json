{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TelemetryTokens.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.telemetry-tokens"
    },
    "accounts": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "accounts"
  ],
  "additionalProperties": false
}
