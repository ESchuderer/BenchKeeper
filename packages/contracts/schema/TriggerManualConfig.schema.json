{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "TriggerManualConfig.schema.json",
  "type": "object",
  "properties": {
    "precheck": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000,
      "pattern": "^[^\\u0000-\\u0008\\u000B-\\u001F\\u007F-\\u009F\\u00AD\\u061C\\u180E\\u200B\\u200E\\u200F\\u2028-\\u202E\\u2060-\\u2064\\u2066-\\u2069\\uFEFF\\uFFF9-\\uFFFB\\u200C\\u200D]*$",
      "description": "A read-only command run before the workflow: exit code 0 starts the run, any other skips it"
    }
  },
  "additionalProperties": false
}
