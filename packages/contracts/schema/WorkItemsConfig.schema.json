{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkItemsConfig.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.work-items"
    },
    "mirroring": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9-]{1,39}\\/(?!\\.{1,2}$)[A-Za-z0-9._-]{1,100}$"
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "mirroring"
  ],
  "additionalProperties": false
}
