{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkflowDefinition.schema.json",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "cedarloom.workflow"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "minApp": {
          "description": "The oldest CedarLoom version that runs this workflow",
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
        }
      },
      "required": [
        "id",
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "inputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "DataType.schema.json"
          },
          "required": {
            "type": "boolean"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "outputs": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "type": {
            "$ref": "DataType.schema.json"
          },
          "description": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "WorkflowNode.schema.json"
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "$ref": "WorkflowEdge.schema.json"
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "maxConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        },
        "failurePolicy": {
          "description": "For the whole run; `fail_fast` when absent",
          "$ref": "FailurePolicy.schema.json"
        },
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "failurePolicy": {
                "$ref": "FailurePolicy.schema.json"
              },
              "timeoutSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "retries": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "layout": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "x",
              "y"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "nodes"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "metadata",
    "nodes",
    "edges"
  ],
  "additionalProperties": false
}
