{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkflowEdge.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "from": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "handle": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "node",
            "handle"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "input": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "input"
          ],
          "additionalProperties": false
        }
      ]
    },
    "to": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "node": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            },
            "handle": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "node",
            "handle"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "output": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
            }
          },
          "required": [
            "output"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "from",
    "to"
  ],
  "additionalProperties": false
}
