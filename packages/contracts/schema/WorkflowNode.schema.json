{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WorkflowNode.schema.json",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*([./][a-z][a-z0-9-]*)*$",
      "description": "A built-in node type such as `command.run`, or a plugin action `publisher.name/action`; the engine refuses types it does not know"
    },
    "with": {
      "description": "The node's configuration; the engine checks it against the node type",
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "$ref": "JsonValue.schema.json"
      }
    }
  },
  "required": [
    "id",
    "type"
  ],
  "additionalProperties": false
}
