{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "WriteFile.schema.json",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "const": "write"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "description": "Absolute path of the file"
    },
    "before": {
      "anyOf": [
        {
          "$ref": "Sha256.schema.json"
        },
        {
          "type": "null"
        }
      ],
      "description": "Hash the file must have when the plan applies; null: the file must not exist"
    },
    "content": {
      "type": "string"
    },
    "mode": {
      "description": "Permission bits of a file the write creates; a replaced file keeps its own",
      "type": "integer",
      "minimum": 0,
      "maximum": 511
    }
  },
  "required": [
    "kind",
    "path",
    "before",
    "content"
  ],
  "additionalProperties": false
}
