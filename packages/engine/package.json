{
  "name": "@cedarloom/engine",
  "version": "0.0.0",
  "private": true,
  "description": "Applies CedarLoom plans crash-ordered and undoes them as runs of their own.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./graph": "./src/graph.ts",
    "./validate": "./src/validate.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./graph": {
        "types": "./dist/graph.d.ts",
        "default": "./dist/graph.js"
      },
      "./validate": {
        "types": "./dist/validate.d.ts",
        "default": "./dist/validate.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/ledger": "workspace:*"
  },
  "devDependencies": {
    "fast-check": "catalog:"
  }
}
