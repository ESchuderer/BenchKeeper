{
  "schemaVersion": 1,
  "kind": "cedarloom.extension",
  "id": "cedarloom.claude-swap",
  "version": "0.0.0",
  "name": "claude-swap",
  "description": "Every Claude Code account's usage, and the account interactive sessions use, from the user's claude-swap.",
  "license": "MIT",
  "api": "1.0",
  "runtime": {
    "kind": "node",
    "entry": "main.mjs"
  },
  "capabilities": {
    "programs": {
      "cswap": {
        "darwin": ["cswap", "~/.local/bin/cswap"],
        "linux": ["cswap", "~/.local/bin/cswap"],
        "win32": ["cswap"]
      },
      "uv": {
        "darwin": ["uv", "~/.local/bin/uv", "~/.cargo/bin/uv"],
        "linux": ["uv", "~/.local/bin/uv", "~/.cargo/bin/uv"],
        "win32": ["uv"]
      },
      "pipx": {
        "darwin": ["pipx", "~/.local/bin/pipx"],
        "linux": ["pipx", "~/.local/bin/pipx"],
        "win32": ["pipx"]
      }
    }
  },
  "contributes": {
    "actions": {
      "status": {
        "title": "claude-swap status",
        "outputs": {
          "installed": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "description": "Absent when claude-swap is not installed"
          },
          "accounts": {
            "type": "number",
            "description": "The accounts claude-swap manages"
          },
          "active": {
            "type": "number",
            "description": "The account interactive sessions use; absent when none"
          }
        }
      },
      "install": {
        "title": "Install claude-swap",
        "outputs": {
          "installed": {
            "type": "boolean"
          },
          "version": {
            "type": "string",
            "description": "Absent while claude-swap is not installed"
          },
          "runs": {
            "type": "string",
            "description": "The command the install runs once allowed"
          },
          "approve": {
            "type": "string",
            "description": "The command line that allows it"
          }
        }
      },
      "auto": {
        "title": "claude-swap's auto mode",
        "outputs": {
          "service": {
            "type": "string",
            "description": "claude-swap's first line on its menu bar service; macOS only"
          },
          "hint": {
            "type": "string",
            "description": "What to do next for claude-swap's auto mode"
          }
        }
      },
      "auto-on": {
        "title": "Install claude-swap's menu bar service",
        "outputs": {
          "service": {
            "type": "string",
            "description": "claude-swap's first line on its menu bar service; macOS only"
          },
          "hint": {
            "type": "string",
            "description": "What to do next for claude-swap's auto mode"
          },
          "runs": {
            "type": "string",
            "description": "The command it runs once allowed"
          },
          "approve": {
            "type": "string",
            "description": "The command line that allows it"
          }
        }
      },
      "auto-off": {
        "title": "Remove claude-swap's menu bar service",
        "outputs": {
          "service": {
            "type": "string",
            "description": "claude-swap's first line on its menu bar service; macOS only"
          },
          "runs": {
            "type": "string",
            "description": "The command it runs once allowed"
          },
          "approve": {
            "type": "string",
            "description": "The command line that allows it"
          },
          "hint": {
            "type": "string",
            "description": "What claude-swap's auto mode does now, or where it runs instead"
          }
        }
      }
    },
    "switchTargets": {
      "interactive": {
        "agent": "claude"
      }
    },
    "sessionProviders": {
      "claude": {
        "agent": "claude",
        "program": "cswap"
      }
    },
    "doctor": {
      "claude-swap": {
        "title": "claude-swap"
      }
    },
    "commands": ["status", "install", "auto", "auto-on", "auto-off"]
  }
}
