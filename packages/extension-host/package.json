{
  "name": "@cedarloom/extension-host",
  "version": "0.0.0",
  "private": true,
  "description": "The extension host of CedarLoom: starts an extension under Node's permission flags, speaks the extension protocol with it, and refuses what its trust level may not run.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/extension-sdk": "workspace:*",
    "vscode-jsonrpc": "10.0.0"
  }
}
