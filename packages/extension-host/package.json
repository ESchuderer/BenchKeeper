{
  "name": "@cedarloom/plugin-host",
  "version": "0.0.0",
  "private": true,
  "description": "The plugin host of CedarLoom: starts a plugin under Node's permission flags, speaks the plugin protocol with it, and refuses what its tier may not run.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/plugin-sdk": "workspace:*",
    "vscode-jsonrpc": "10.0.0"
  }
}
