{
  "name": "@cedarloom/orchestration",
  "version": "0.0.0",
  "private": true,
  "description": "The worker launcher of CedarLoom: the clean allowlisted environment of a worker, the paths and hosts it may not reach, and the checks that refuse a launch.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*"
  }
}
