{
  "name": "@cedarloom/orchestration",
  "version": "0.0.0",
  "private": true,
  "description": "The worker launcher of CedarLoom: the clean allowlisted environment of a worker, the paths and hosts it may not reach, the checks that refuse a launch, and the guard hook of its shell commands.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./guard-hook": "./src/guard-hook.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./guard-hook": {
        "types": "./dist/guard-hook.d.ts",
        "default": "./dist/guard-hook.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*"
  },
  "devDependencies": {
    "zod": "catalog:"
  }
}
