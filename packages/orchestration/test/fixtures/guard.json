{
  "source": "Command shapes as agents and people type them: Claude Code's commit with a heredoc message, git's documented push, fetch, clone, config and remote forms, the usual install pipe, every evasion of the guard's reviews, and everyday forms outside the guard's grammar, which it refuses. A case's rule is the guard's answer, null when it lets the call run. Cases are grouped by policy and folder; each is its name, the command and the rule.",
  "policies": {
    "worker": {
      "schemaVersion": 1,
      "repositories": ["acme/app", "acme/tracker"],
      "hub": "acme/tracker",
      "memory": "acme/notes"
    },
    "interactive": {
      "schemaVersion": 1,
      "repositories": null,
      "hub": "acme/tracker",
      "memory": "acme/notes"
    }
  },
  "remotes": {
    "/work/app": {
      "origin": ["https://github.com/acme/app.git"]
    },
    "/work/fork": {
      "origin": ["git@github.com:acme/app.git"],
      "upstream": ["https://github.com/other/fork.git"]
    },
    "/work/notes": {
      "origin": ["git@github.com:acme/notes.git"]
    }
  },
  "cases": {
    "worker /work/app": [
      [
