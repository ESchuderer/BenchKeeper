      ["git in capitals", "GIT push -f origin x", "forbidden"],
      ["git.exe", "git.exe push -f origin x", "forbidden"],
      ["git-push by its path", "/usr/libexec/git-core/git-push -f origin x", "forbidden"],
      ["an abbreviated --no-verify", "git commit --no-veri -m x", "forbidden"],
