      ["fish --command attached", "fish --command='sudo rm -rf /tmp/x'", "unreadable"],
      ["a script from /dev/stdin", "echo x | bash /dev/stdin", "unreadable"],
      ["a script from a process substitution", "bash <(echo x)", "unreadable"],
      ["source of a here-string", "source /dev/stdin <<< 'sudo rm -rf /tmp/x'", "unreadable"],
