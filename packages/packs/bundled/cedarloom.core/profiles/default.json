{
  "schemaVersion": 1,
  "kind": "cedarloom.profile",
  "id": "cedarloom.default",
  "version": "0.1.0",
  "name": "The CedarLoom way",
  "description": "Claude Code with the CedarLoom, Ponytail and Matt Pocock plugins and CedarLoom's rules; a hub repository for issues and owner questions; a memory repository; project rules, gates and the dev container command.",
  "license": "MIT",
  "minApp": "0.1.0",
  "agents": ["claude-code"],
  "packs": {
    "cedarloom.core": {
      "bundled": true
    },
    "cedarloom.orca": {
      "bundled": true
    }
  },
  "machine": {
    "plugin.cedarloom": {
      "type": "plugin",
      "title": "CedarLoom workflow plugin",
      "default": "on",
      "plugin": "cedarloom@cedarloom",
      "marketplace": {
        "name": "cedarloom",
        "git": "https://github.com/cedarloom/cedarloom.git",
        "ref": "stable"
      }
    },
    "plugin.ponytail": {
      "type": "plugin",
      "title": "Ponytail, level full",
      "default": "on",
      "plugin": "ponytail@ponytail",
      "marketplace": {
        "name": "ponytail",
        "github": "DietrichGebert/ponytail",
        "autoUpdate": false
      },
      "options": {
        "file": ".config/ponytail/config.json",
        "set": {
          "defaultMode": "full"
        }
      }
    },
    "plugin.matt-pocock": {
      "type": "plugin",
      "title": "Matt Pocock's skills",
      "default": "on",
      "plugin": "mattpocock-skills@claude-plugins-official"
    },
    "skill.find-skills": {
      "type": "skill",
      "title": "find-skills",
      "default": "on",
      "source": {
        "git": "https://github.com/vercel-labs/skills.git",
        "ref": "main",
        "path": "skills/find-skills"
      }
    },
    "rules.global": {
      "type": "rules",
      "title": "Global rules",
      "default": "on",
      "file": "00-global.md",
      "text": {
        "pack": "cedarloom.core",
        "path": "rules/global.md"
      }
    },
    "settings.claude-code": {
      "type": "settings",
      "title": "Claude Code settings",
      "default": "on",
      "set": {
        "autoUpdatesChannel": "stable",
        "showClearContextOnPlanAccept": true,
        "attribution": {
          "commit": "",
          "pr": ""
        },
        "autoMemoryEnabled": false,
        "feedbackDrafts": "off",
        "env": {
          "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
          "DISABLE_ERROR_REPORTING": "1",
          "DISABLE_FEEDBACK_COMMAND": "1",
          "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
        }
      }
    }
  },
  "workspace": {
    "hub": {
      "type": "hub",
      "title": "Hub repository: issues, triage labels and owner questions",
      "default": "on",
      "labels": {
        "needs-triage": {
          "color": "f9d0c4"
        },
        "needs-info": {
          "color": "b60205"
        },
        "ready-for-agent": {
          "color": "fef2c0"
        },
        "ready-for-human": {
          "color": "1d76db"
        },
        "wontfix": {
          "color": "ffffff",
          "description": "This will not be worked on"
        },
        "question": {
          "color": "d876e3",
          "description": "Owner decision needed: tick an option or comment, then set ready-for-agent"
        },
        "deferred": {
          "color": "c5def5",
          "description": "Owner deferred: the question queue skips it until the label is removed"
        }
      },
      "projectLabel": {
        "prefix": "project:",
        "color": "1d76db"
      },
      "rules": {
        "pack": "cedarloom.core",
        "path": "rules/questions.md"
      }
    },
    "memory": {
      "type": "memory",
      "title": "Memory repository and its loader",
      "default": "on",
      "scaffold": {
        "pack": "cedarloom.core",
        "path": "templates/memory"
      },
      "loader": true
    }
  },
  "project": {
    "manual": {
      "type": "manual",
      "title": "AGENTS.md rules and CLAUDE.md import",
      "default": "on",
      "claudeImport": true,
      "rules": [
        {
          "pack": "cedarloom.core",
          "path": "rules/project.md"
        },
        {
          "pack": "cedarloom.core",
          "path": "rules/family.md"
        },
        {
          "pack": "cedarloom.core",
          "path": "rules/tests.md"
        }
      ]
    },
    "local-manual": {
      "type": "local-manual",
      "title": "Machine-local line: where issues and owner questions go",
      "default": "on",
      "requires": ["workspace.hub"],
      "rules": [
        {
          "pack": "cedarloom.core",
          "path": "rules/local.md"
        }
      ]
    },
    "agent-docs": {
      "type": "files",
      "title": "docs/agents for Matt Pocock's skills",
      "default": "on",
      "commit": true,
      "requires": ["workspace.hub"],
      "files": {
        "docs/agents/issue-tracker.md": {
          "pack": "cedarloom.core",
          "path": "templates/issue-tracker.md"
        },
        "docs/agents/triage-labels.md": {
          "pack": "cedarloom.core",
          "path": "templates/triage-labels.md"
        },
        "docs/agents/domain.md": {
          "pack": "cedarloom.core",
          "path": "templates/domain.md"
        }
      }
    },
    "dc-wrapper": {
      "type": "files",
      "title": "scripts/dc, the dev container command",
      "default": "auto",
      "when": "devcontainer",
      "commit": false,
      "files": {
        "scripts/dc": {
          "pack": "cedarloom.core",
          "path": "templates/dc.sh"
        }
      }
    },
    "dc-line": {
      "type": "local-manual",
      "title": "Machine-local line: the dev container command",
      "default": "auto",
      "when": "devcontainer",
      "rules": [
        {
          "pack": "cedarloom.core",
          "path": "rules/dc.md"
        }
      ],
      "requires": ["project.dc-wrapper"]
    },
    "guards": {
      "type": "settings",
      "title": "Deny rules: no --no-verify, no force push, no sudo, no infrastructure apply",
      "default": "on",
      "commit": true,
      "set": {
        "permissions": {
          "deny": [
            "Bash(git commit *--no-verify*)",
            "Bash(git commit -n*)",
            "Bash(git commit * -n*)",
            "Bash(git push *--no-verify*)",
            "Bash(git push *--force*)",
            "Bash(git push -f*)",
            "Bash(git push * -f*)",
            "Bash(git push * +*)",
            "Bash(sudo *)",
            "Bash(terraform apply *)",
            "Bash(kubectl apply *)",
            "Bash(helm upgrade *)"
          ]
        }
      }
    },
    "sandbox": {
      "type": "settings",
      "title": "Claude Code's sandbox for Bash commands, on this machine",
      "description": "Commands still ask before they run. Off by default: it runs on macOS, Linux and WSL2 only, Linux needs bubblewrap and socat, and docker, which the dev container command runs, fails inside it (https://code.claude.com/docs/en/sandboxing).",
      "default": "off",
      "commit": false,
      "set": { "sandbox": { "enabled": true, "autoAllowBashIfSandboxed": false } }
    },
    "tier": {
      "type": "tier",
      "title": "Default tier: the agent picks per request",
      "default": "on",
      "tier": null
    },
    "gates": {
      "type": "gates",
      "title": "CI gates from your reusable workflows, Dependabot with a 3-day cooldown",
      "default": "auto",
      "when": "gates",
      "callers": ["check"],
      "dependabotCooldownDays": 3
    },
    "orca": {
      "type": "files",
      "title": "Orca worktree setup",
      "default": "auto",
      "when": "orca",
      "commit": false,
      "files": {
        "orca.yaml": {
          "pack": "cedarloom.orca",
          "path": "templates/orca.yaml"
        },
        ".worktreeinclude": {
          "pack": "cedarloom.orca",
          "path": "templates/worktreeinclude"
        }
      }
    },
    "packs": {
      "type": "packs",
      "title": "Skill packs for this project",
      "default": "on",
      "packs": []
    }
  }
}
