{
  "name": "@cedarloom/plugin-sdk",
  "version": "0.0.0",
  "private": true,
  "description": "Write a CedarLoom plugin: the JSON-RPC protocol between the plugin host and a plugin, and definePlugin, which serves a plugin's actions over stdio.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "vscode-jsonrpc": "10.0.0"
  }
}
