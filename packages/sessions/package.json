{
  "name": "@cedarloom/sessions",
  "version": "0.0.0",
  "private": true,
  "description": "Reads the agent sessions of this machine from the Claude Code session logs, with their time, tokens, cost and tests.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/git": "workspace:*",
    "shell-quote": "1.12.0",
    "zod": "catalog:"
  }
}
