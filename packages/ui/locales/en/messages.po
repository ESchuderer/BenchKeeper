#. js-lingui-explicit-id
msgid "problem.documentInvalid"
msgstr "It does not match the workflow schema: {issues}."

#. js-lingui-explicit-id
msgid "problem.documentNewer"
msgstr "It has schema version {found}; this CedarLoom reads up to {known}."

#. js-lingui-explicit-id
msgid "problem.duplicateId"
msgstr "More than one {kind} has the id {id}."

#. js-lingui-explicit-id
msgid "problem.triggerCount"
msgstr "The workflow has {count} trigger nodes; it needs exactly one."

#. js-lingui-explicit-id
msgid "problem.unknownNodeType"
msgstr "Node {node} has the type {type}, which this CedarLoom does not know."

#. js-lingui-explicit-id
msgid "problem.invalidConfig"
msgstr "The configuration of node {node} does not match its type: {issues}."

#. js-lingui-explicit-id
msgid "problem.danglingEdge"
msgstr "Edge {edge} starts or ends at {ref}, which does not exist."

#. js-lingui-explicit-id
msgid "problem.unknownHandle"
msgstr "Edge {edge} uses the handle {handle}, which that node type lacks."

#. js-lingui-explicit-id
msgid "problem.incompatibleHandles"
msgstr "Edge {edge} joins a {from} output to a {to} input, which cannot take it."

#. js-lingui-explicit-id
msgid "problem.uncheckedHandles"
msgstr "Edge {edge} passes {from} to a {to} input; the value is checked only when the workflow runs."

#. js-lingui-explicit-id
msgid "problem.manySources"
msgstr "{target} gets {count} edges; it takes one."

#. js-lingui-explicit-id
msgid "problem.missingSource"
msgstr "{target} gets no edge, but it needs one."

#. js-lingui-explicit-id
msgid "problem.cycle"
msgstr "The nodes {nodes} form a cycle; repeats need an explicit loop node."

#. js-lingui-explicit-id
msgid "problem.joinBranches"
msgstr "Join {node} has {count} incoming branches; a join needs at least two."

#. js-lingui-explicit-id
msgid "problem.exclusiveSources"
msgstr "Input {handle} of node {node} waits for outputs of {from} of which only one fires, so {node} is always skipped; merge them in a join with policy any."

#. js-lingui-explicit-id
msgid "problem.optionalInput"
msgstr "Input {handle} of node {node} needs a value, but the workflow input {input} is optional and has no default."

#. js-lingui-explicit-id
msgid "problem.scheduleInput"
msgstr "A schedule starts this workflow without inputs, so the required input {input} needs a default."

#. js-lingui-explicit-id
msgid "problem.unreachable"
msgstr "Nothing leads to node {node} from the trigger or an input, so it never runs."

#. js-lingui-explicit-id
msgid "problem.strayEntry"
msgstr "The {section} section names node {node}, which the workflow does not have."

#. js-lingui-explicit-id
msgid "problem.nodeInput"
msgstr "Input {handle} of node {node}"

#. js-lingui-explicit-id
msgid "problem.workflowOutput"
msgstr "The workflow output {handle}"

#. js-lingui-explicit-id
msgid "problem.duplicateEdge"
msgstr "Edge {edge} joins the same output to the same input as edge {of}; remove one."

#. js-lingui-explicit-id
msgid "editor.keepOne"
msgstr "A workflow keeps at least one node, so nothing was removed."

#. js-lingui-explicit-id
msgid "editor.problemCount"
msgstr "{count, plural, one {# problem.} other {# problems.}}"

#. js-lingui-explicit-id
msgid "editor.unreadable"
msgstr "The file could not be read, so nothing was imported."
