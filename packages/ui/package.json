{
  "name": "@cedarloom/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The CedarLoom web UI: Mantine views over the local API, built by Vite into dist/, which the local server serves.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "vite build",
    "catalog": "lingui compile --namespace json && biome format --write locales",
    "test:ui": "vite build && playwright test --forbid-only"
  },
  "dependencies": {
    "@cedarloom/client": "workspace:*",
    "@lingui/core": "6.11.0",
    "@mantine/core": "9.7.4",
    "@mantine/hooks": "9.7.4",
    "lucide-react": "1.66.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cedarloom/server": "workspace:*",
    "@cedarloom/services": "workspace:*",
    "@lingui/cli": "6.11.0",
    "@lingui/format-po": "6.11.0",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "vite": "8.3.5"
  }
}
