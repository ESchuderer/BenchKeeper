{
  "name": "@cedarloom/ui",
  "version": "0.0.0",
  "private": true,
  "description": "The CedarLoom web UI: Mantine views over the local API, built by Vite into dist/, which the local server serves.",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "vite build",
    "catalog": "lingui compile --namespace json && node scripts/catalog.ts && biome format --write locales",
    "test:ui": "vite build && playwright test --forbid-only --browser=chromium",
    "prepack": "vite build",
    "test": "vitest run --config ../../vitest.config.ts --coverage.include=src/workflow/*.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@cedarloom/client": "workspace:*",
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/engine": "workspace:*",
    "@cedarloom/server": "workspace:*",
    "@cedarloom/use-cases": "workspace:*",
    "@lingui/cli": "6.12.0",
    "@lingui/core": "6.12.0",
    "@lingui/format-po": "6.12.0",
    "@mantine/core": "9.7.5",
    "@mantine/hooks": "9.7.5",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "fast-check": "catalog:",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6",
    "zod": "catalog:"
  }
}
