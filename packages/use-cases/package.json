{
  "name": "@cedarloom/use-cases",
  "version": "0.0.0",
  "private": true,
  "description": "The CedarLoom use cases: plan, apply, undo and the doctor on the run store, shared by the CLI and the local server.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc -b test",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "dependencies": {
    "@cedarloom/contracts": "workspace:*",
    "@cedarloom/engine": "workspace:*",
    "@cedarloom/extension-host": "workspace:*",
    "@cedarloom/git": "workspace:*",
    "@cedarloom/ledger": "workspace:*",
    "@cedarloom/orchestration": "workspace:*",
    "@cedarloom/profiles": "workspace:*",
    "@cedarloom/work-items": "workspace:*"
  },
  "devDependencies": {
    "zod": "catalog:"
  }
}
