{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchKeeper pins: who runs a phase",
  "type": "object",
  "required": ["schemaVersion", "phases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "phases": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "research": { "$ref": "#/$defs/pin" },
        "implement": { "$ref": "#/$defs/pin" },
        "review": { "$ref": "#/$defs/pin" },
        "verify": { "$ref": "#/$defs/pin" }
      }
    }
  },
  "$defs": {
    "pin": {
      "type": "object",
      "properties": {
        "agent": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$" },
        "model": { "type": "string", "pattern": "^(default|[A-Za-z0-9][A-Za-z0-9._:/@-]{0,99})$" },
        "effort": { "type": "string", "pattern": "^(default|[A-Za-z0-9][A-Za-z0-9._-]{0,31})$" }
      }
    }
  }
}
