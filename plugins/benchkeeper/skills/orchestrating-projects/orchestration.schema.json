{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BenchKeeper orchestrator policy (docs/agents/orchestration.json)",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^//": {} },
  "properties": {
    "schemaVersion": { "enum": [1, 2] },
    "startLabel": { "type": "string", "minLength": 1 },
    "trustedAuthors": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "workersPerProject": { "type": "integer", "minimum": 1, "maximum": 32 },
    "hostWorkerLimit": { "type": "integer", "minimum": 1, "maximum": 64 },
    "stallMinutes": { "type": "integer", "minimum": 1, "maximum": 1440 },
    "issuesPerWorker": { "type": "integer", "minimum": 1, "maximum": 16 },
    "keepRunning": { "type": "boolean" },
    "permissionPrompts": { "enum": ["block", "decline"] },
    "minPlugin": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "issues": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9-]*/(?!\\.\\.?$)[A-Za-z0-9._-]+$" },
        "labels": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "worker": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^//": {} },
          "properties": {
            "model": { "type": "string", "minLength": 1 },
            "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] }
          }
        },
        "phases": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": { "^//": {} },
          "properties": {
            "plan": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "model": { "enum": ["fable", "opus", "sonnet", "haiku", "inherit"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } },
            "implement": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "model": { "enum": ["fable", "opus", "sonnet", "haiku", "inherit"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } },
            "test": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "model": { "enum": ["fable", "opus", "sonnet", "haiku", "inherit"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } },
            "review": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "model": { "enum": ["fable", "opus", "sonnet", "haiku", "inherit"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } },
            "research": { "type": "object", "additionalProperties": false, "patternProperties": { "^//": {} }, "properties": { "model": { "enum": ["fable", "opus", "sonnet", "haiku", "inherit"] }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max"] } } }
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "depth": { "enum": ["low", "medium", "high", "xhigh"] },
        "sensitiveDepth": { "enum": ["low", "medium", "high", "xhigh"] },
        "sensitivePaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[^\\\\*]+$" } }
      }
    },
    "merge": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": { "^//": {} },
      "properties": {
        "allowed": { "type": "boolean" },
        "requiredChecks": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "mode": { "enum": ["strict", "disjoint"] },
        "additivePaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[^\\\\*]+$" } },
        "ownerOnlyPaths": { "type": "array", "items": { "type": "string", "pattern": "^(?!/)(?![\\s\\S]*(?:^|/)\\.\\.(?:/|$))[^\\\\*]+$" } }
      }
    },
    "closeIssue": { "type": "boolean" },
    "deleteMergedBranch": { "type": "boolean" }
  }
}
