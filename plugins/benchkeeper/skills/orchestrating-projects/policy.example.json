{
  "schemaVersion": 2,
  "startLabel": "ready-for-agent",
  "trustedAuthors": ["example-review-bot[bot]"],
  "workersPerProject": 1,
  "hostWorkerLimit": 3,
  "stallMinutes": 20,
  "issuesPerWorker": 1,
  "keepRunning": false,
  "permissionPrompts": "block",
  "review": {
    "depth": "high",
    "sensitiveDepth": "high"
  },
  "merge": {
    "allowed": true,
    "requiredChecks": ["ci"],
    "mode": "strict"
  },
  "closeIssue": true,
  "deleteMergedBranch": false
}
