{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "plugins": [
    { "type": "node-workspace", "merge": false },
    {
      "type": "linked-versions",
      "groupName": "cedarloom",
      "components": ["cli", "client", "contracts", "engine", "ledger", "server", "services", "ui"]
    }
  ],
  "packages": {
    "packages/cli": { "component": "cli" },
    "packages/client": { "component": "client" },
    "packages/contracts": { "component": "contracts" },
    "packages/engine": { "component": "engine" },
    "packages/ledger": { "component": "ledger" },
    "packages/server": {
      "component": "server",
      "extra-files": [{ "type": "json", "path": "openapi.json", "jsonpath": "$.info.version" }]
    },
    "packages/services": { "component": "services" },
    "packages/ui": { "component": "ui" }
  }
}
