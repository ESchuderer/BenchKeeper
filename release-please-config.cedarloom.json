{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "plugins": [
    { "type": "node-workspace", "merge": false },
    { "type": "linked-versions", "groupName": "cedarloom", "components": ["cli", "contracts", "engine", "ledger"] }
  ],
  "packages": {
    "packages/cli": { "component": "cli" },
    "packages/contracts": {
      "component": "contracts",
      "extra-files": [{ "type": "json", "path": "openapi.json", "jsonpath": "$.info.version" }]
    },
    "packages/engine": { "component": "engine" },
    "packages/ledger": { "component": "ledger" }
  }
}
