{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "plugins": [
    { "type": "node-workspace", "merge": false },
    {
      "type": "linked-versions",
      "groupName": "cedarloom",
      "components": [
        "accounts",
        "adapter-claude",
        "agent-contracts",
        "cli",
        "client",
        "contracts",
        "engine",
        "extension-host",
        "extension-orca",
        "git",
        "ledger",
        "orchestration",
        "packs",
        "profiles",
        "server",
        "ui",
        "use-cases"
      ]
    }
  ],
  "packages": {
    "packages/accounts": { "component": "accounts" },
    "packages/adapter-claude": { "component": "adapter-claude" },
    "packages/agent-contracts": { "component": "agent-contracts" },
    "packages/cli": { "component": "cli" },
    "packages/client": { "component": "client" },
    "packages/contracts": { "component": "contracts" },
    "packages/engine": { "component": "engine" },
    "packages/extension-host": { "component": "extension-host" },
    "packages/extension-orca": { "component": "extension-orca" },
    "packages/extension-sdk": { "component": "extension-sdk" },
    "packages/git": { "component": "git" },
    "packages/ledger": { "component": "ledger" },
    "packages/orchestration": { "component": "orchestration" },
    "packages/packs": { "component": "packs" },
    "packages/profiles": { "component": "profiles" },
    "packages/server": {
      "component": "server",
      "extra-files": [{ "type": "json", "path": "openapi.json", "jsonpath": "$.info.version" }]
    },
    "packages/ui": { "component": "ui" },
    "packages/use-cases": { "component": "use-cases" }
  }
}
