{
  "name": "benchkeeper-site",
  "private": true,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "start": "node scripts/generate.mjs && docusaurus start --host 0.0.0.0",
    "build": "node scripts/generate.mjs && docusaurus build --out-dir dist",
    "serve": "docusaurus serve --dir dist --no-open",
    "test": "playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "sharp": "0.35.5"
  },
  "overrides": {
    "tinypool": "2.1.2"
  }
}
