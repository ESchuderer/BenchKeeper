---
// Theme toggle and system scheme listener of every page; goes at the end of body.
import { themeKey } from '../lib/edition';
---
<script is:inline define:vars={{ themeKey }}>
  (function () {
    var root = document.documentElement, key = themeKey, mq = matchMedia('(prefers-color-scheme: dark)');
    var button = document.querySelector('[data-theme-toggle]');
    function set(s) { root.setAttribute('data-mantine-color-scheme', s); button.setAttribute('aria-pressed', s === 'dark'); }
    function stored() { try { return localStorage.getItem(key); } catch (e) { return null; } }
    set(root.getAttribute('data-mantine-color-scheme'));
    button.addEventListener('click', function () {
      var next = root.getAttribute('data-mantine-color-scheme') === 'dark' ? 'light' : 'dark';
      set(next);
      try { localStorage.setItem(key, next); } catch (e) {}
    });
    mq.addEventListener('change', function () {
      var v = stored();
      if (v !== 'light' && v !== 'dark') set(mq.matches ? 'dark' : 'light');
    });
  })();
</script>
