---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import SiteLayout from '../layouts/SiteLayout.astro';
import '@mantine/core/styles/Code.css';
import AppPage, { VIEWS } from '../components/AppPage';

// The build runs in web/ (npm run build). The shots are lossless WebP (a VP8L chunk at byte 12): width and height minus
// one are the two 14-bit fields of the little-endian integer at byte 21.
const dir = join(process.cwd(), 'public', 'app');
const shots = Object.fromEntries(VIEWS.flatMap(({ shot: v }) => ['light', 'dark'].map((s) => {
  const file = readFileSync(join(dir, `${v}-${s}.webp`));
  if (file.toString('latin1', 12, 16) !== 'VP8L') throw new Error(`${v}-${s}.webp is not lossless WebP`);
  const size = file.readUInt32LE(21);
  return [`${v}-${s}`, { width: (size & 0x3fff) + 1, height: ((size >>> 14) & 0x3fff) + 1 }];
})));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout title="The app, BenchKeeper"
  description="What the BenchKeeper app shows, view by view, with the matching CLI command and screenshots of example data.">
  <AppPage base={base} shots={shots} />
</SiteLayout>
