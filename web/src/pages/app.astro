---
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import BenchLayout from '../layouts/BenchLayout.astro';
import '@mantine/core/styles/Code.css';
import AppPage, { VIEWS } from '../components/AppPage';

// The build runs in web/ (npm run build). A PNG's width and height are the two big-endian integers after its signature.
const dir = join(process.cwd(), 'public', 'app');
const shots = Object.fromEntries(VIEWS.flatMap(({ shot: v }) => ['light', 'dark'].map((s) => {
  const png = readFileSync(join(dir, `${v}-${s}.png`));
  return [`${v}-${s}`, { width: png.readUInt32BE(16), height: png.readUInt32BE(20) }];
})));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BenchLayout title="The app, BenchKeeper"
  description="What the BenchKeeper app shows, view by view with the matching CLI command: the starting screen, one-run setup, Dashboard health, Fix everything, projects and packs, skills, project setup, the Sessions board, Rules, Agent settings, History and undo and the Doctor, with screenshots of example data.">
  <AppPage base={base} shots={shots} />
</BenchLayout>
