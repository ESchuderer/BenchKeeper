---
// One page per published run: ranking, top 10 in detail, every arm with review notes and screenshots.
import { join } from 'node:path';
import { readdirSync } from 'node:fs';
import BenchLayout from '../../layouts/BenchLayout.astro';
import { BenchRun } from '../../components/Bench';
import { notes } from '../../data/bench-notes';
import { OFF_SITE, loadTrials, rankArms, summarizeRuns, topByBrief } from '../../../scripts/bench-data.mjs';

export function getStaticPaths() {
  const results = join(process.cwd(), '..', 'bench', 'results');
  const trials = loadTrials(results).filter((t) => !OFF_SITE.has(t.run));
  const tops = topByBrief(trials);
  return summarizeRuns(trials, readdirSync(results).filter((f) => f.endsWith('.md'))).map((r) => {
    const own = trials.filter((t) => t.run === r.run);
    // the brief's top 10 spans its runs; on the site each brief has one run
    const top = own.some((t) => t.final) ? tops.find((x) => x.brief === r.brief) : undefined;
    return { params: { run: r.run }, props: { r, ranking: rankArms(own), top } };
  });
}
const { r, ranking, top } = Astro.props;
const shots = ranking.groups.some((g) => g.rows.some((x) => x.rounds.some((t) => t.screenshots.length > 0)));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BenchLayout title={`${r.brief}, ${r.model}: benchmark, BenchKeeper`}
  description={`BenchKeeper benchmark run ${r.run}: ranking of all arms, review notes${shots ? ' and app screenshots' : ''}.`}>
  <BenchRun base={base} r={r} ranking={ranking} top={top} notes={notes} />
</BenchLayout>
