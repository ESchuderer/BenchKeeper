---
import { join } from 'node:path';
import { readdirSync } from 'node:fs';
import BenchLayout from '../../layouts/BenchLayout.astro';
import BenchSummary from '../../components/Bench';
import { notes } from '../../data/bench-notes';
import { loadTrials, rankArms, summarizeRuns } from '../../../scripts/bench-data.mjs';

// The build runs in web/ (npm run build), next to bench/.
const results = join(process.cwd(), '..', 'bench', 'results');
const trials = loadTrials(results);
const runs = summarizeRuns(trials, readdirSync(results).filter((f) => f.endsWith('.md')))
  .map((run) => ({ run, ranking: rankArms(trials.filter((t) => t.run === run.run)) }));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BenchLayout title="Benchmarks, BenchKeeper"
  description="BenchKeeper benchmark summary: the winners and the top 10 of each published run, with a page per run for every arm and its review notes.">
  <BenchSummary base={base} runs={runs} notes={notes} />
</BenchLayout>
