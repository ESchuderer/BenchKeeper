---
import BenchLayout from '../../layouts/BenchLayout.astro';
import BenchSummary from '../../components/Bench';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BenchLayout title="Benchmarks, BenchKeeper"
  description="Headline numbers of the BenchKeeper benchmark, how to reproduce a run, and the link to the BenchKeeper-Eval repository with briefs, scorer and recorded results.">
  <BenchSummary base={base} />
</BenchLayout>
