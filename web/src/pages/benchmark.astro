---
import SiteLayout from '../layouts/SiteLayout.astro';
import '@mantine/core/styles/Code.css';
import BenchmarkPage from '../components/BenchmarkPage';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<SiteLayout title="Benchmark, BenchKeeper"
  description="What the BenchKeeper benchmark measures, how a result is produced, how to read one, and where the recorded results and the method live.">
  <BenchmarkPage base={base} />
</SiteLayout>
