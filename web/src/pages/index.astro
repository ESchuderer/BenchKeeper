---
import SiteLayout from '../layouts/SiteLayout.astro';
import '@mantine/core/styles/Paper.css';
import '@mantine/core/styles/Alert.css';
import '@mantine/core/styles/Badge.css';
import '@mantine/core/styles/Card.css';
import '@mantine/core/styles/Code.css';
import '@mantine/core/styles/List.css';
import '@mantine/core/styles/SimpleGrid.css';
import '@mantine/core/styles/ThemeIcon.css';
import '@mantine/core/styles/Timeline.css';
import '@mantine/core/styles/VisuallyHidden.css';
import Page from '../components/Page';
import facts from '../data/facts.json';

import { execSync } from 'node:child_process';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { tagline: description } = facts;
const title = 'BenchKeeper: rules, workflow and setup for Claude Code and Codex';
// Last commit for the footer; builds without git (e.g. a slim container) omit it.
let updated: string | undefined, commit: string | undefined;
try {
  [updated, commit] = execSync('git log -1 --format=%cs%n%H', { encoding: 'utf8' }).trim().split('\n');
} catch {}
---
<SiteLayout title={title} description={description} imageAlt={`BenchKeeper logo. ${description}`}>
  <Page base={base} updated={updated} commit={commit} />
  <script is:inline>
    (function () {
      var status = document.querySelector('[data-copy-status]'), copyTimer;
      document.querySelectorAll('[data-copy]').forEach(function (b) {
        b.addEventListener('click', function () {
          function done(msg) {
            clearTimeout(copyTimer); status.textContent = msg;
            copyTimer = setTimeout(function () { document.querySelectorAll('[data-copy].copied').forEach(function (c) { c.classList.remove('copied'); }); status.textContent = ''; }, 1500);
          }
          // Clipboard needs a secure context (https or localhost).
          if (!navigator.clipboard) return done('Copy is not available. Select the command instead.');
          navigator.clipboard.writeText(b.getAttribute('data-copy')).then(function () { document.querySelectorAll('[data-copy].copied').forEach(function (c) { c.classList.remove('copied'); }); b.classList.add('copied'); done('Copied'); },
            function () { done('Copy failed. Select the command instead.'); });
        });
      });
      // Quick start tabs (WAI-ARIA tabs pattern): without this script both panels stay visible.
      var qs = document.querySelector('.qs'), tabs = [].slice.call(qs.querySelectorAll('[role="tab"]')), panels = [].slice.call(qs.querySelectorAll('.qs-panel'));
      function pick(i, focus) {
        tabs.forEach(function (t, j) { t.setAttribute('aria-selected', j === i); t.tabIndex = j === i ? 0 : -1; panels[j].hidden = j !== i; });
        if (focus) tabs[i].focus();
      }
      qs.classList.add('qs-js');
      qs.querySelector('[role="tablist"]').hidden = false;
      panels.forEach(function (p, i) { p.setAttribute('role', 'tabpanel'); p.setAttribute('aria-labelledby', 'qs-tab-' + i); });
      tabs.forEach(function (t, i) {
        t.addEventListener('click', function () { pick(i); });
        t.addEventListener('keydown', function (e) {
          var n = { ArrowRight: i + 1, ArrowLeft: i - 1, Home: 0, End: tabs.length - 1 }[e.key];
          if (n === undefined) return;
          e.preventDefault(); pick((n + tabs.length) % tabs.length, true);
        });
      });
      pick(0);
      // SDLC loop: tooltip follows the cursor on hover devices; a tap or click on a step jumps to its description.
      var wrap = document.querySelector('.ring-wrap'), tip = wrap.querySelector('.ring-tip');
      function place(x, y) {
        var r = wrap.getBoundingClientRect(), w = tip.offsetWidth, h = tip.offsetHeight;
        var left = Math.min(x - r.left + 16, r.width - w - 4), top = y - r.top + 16;
        if (top + h > r.height) top = y - r.top - h - 12;
        tip.style.left = Math.max(4, left) + 'px'; tip.style.top = Math.max(4, top) + 'px';
      }
      wrap.querySelectorAll('[data-tip]').forEach(function (el) {
        function show(x, y) { tip.textContent = el.getAttribute('data-tip'); tip.hidden = false; place(x, y); }
        if (matchMedia('(hover: hover)').matches) {
          el.addEventListener('mousemove', function (e) { show(e.clientX, e.clientY); });
          el.addEventListener('mouseleave', function () { tip.hidden = true; });
        }
        el.addEventListener('focus', function () { var b = el.getBoundingClientRect(); show(b.right, b.top); });
        el.addEventListener('blur', function () { tip.hidden = true; });
        el.addEventListener('click', function () { tip.hidden = true; });
      });
    })();
  </script>
</SiteLayout>
