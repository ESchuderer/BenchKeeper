---
import '@mantine/core/styles/baseline.css';
import '@mantine/core/styles/default-css-variables.css';
import '@mantine/core/styles/global.css';
import '@mantine/core/styles/UnstyledButton.css';
import '@mantine/core/styles/Loader.css';
import '@mantine/core/styles/Paper.css';
import '@mantine/core/styles/Text.css';
import '@mantine/core/styles/Flex.css';
import '@mantine/core/styles/Grid.css';
import '@mantine/core/styles/ActionIcon.css';
import '@mantine/core/styles/Alert.css';
import '@mantine/core/styles/Anchor.css';
import '@mantine/core/styles/Badge.css';
import '@mantine/core/styles/Button.css';
import '@mantine/core/styles/Card.css';
import '@mantine/core/styles/Code.css';
import '@mantine/core/styles/Container.css';
import '@mantine/core/styles/Group.css';
import '@mantine/core/styles/List.css';
import '@mantine/core/styles/Progress.css';
import '@mantine/core/styles/SimpleGrid.css';
import '@mantine/core/styles/Stack.css';
import '@mantine/core/styles/Table.css';
import '@mantine/core/styles/ThemeIcon.css';
import '@mantine/core/styles/Timeline.css';
import '@mantine/core/styles/Title.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import Page from '../components/Page';

import { execSync } from 'node:child_process';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = new URL(`${base}/`, Astro.site).href;
const description = "BenchKeeper keeps your AI coding agents' workbench in order: Claude Code or Codex runs its skills to install and check rules, skills and tools at pinned versions, machine-wide and per repository.";
// Last commit for the footer; builds without git (e.g. a slim container) omit it.
let updated: string | undefined, commit: string | undefined;
try {
  [updated, commit] = execSync('git log -1 --format=%cs%n%H', { encoding: 'utf8' }).trim().split('\n');
} catch {}
---
<!doctype html>
<html lang="en" data-mantine-color-scheme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BenchKeeper</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={pageUrl}>
  <meta property="og:type" content="website">
  <meta property="og:title" content="BenchKeeper">
  <meta property="og:description" content={description}>
  <meta property="og:url" content={pageUrl}>
  <meta property="og:image" content={new URL('og.png', pageUrl).href}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta property="og:image:alt" content="BenchKeeper logo and tagline">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="icon" href={`${base}/logo.svg`} type="image/svg+xml">
  <script is:inline>
    (function () {
      var v = null;
      try { v = localStorage.getItem('mantine-color-scheme-value'); } catch (e) {}
      var s = v === 'light' || v === 'dark' ? v : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-mantine-color-scheme', s);
    })();
  </script>
</head>
<body>
  <Page base={base} updated={updated} commit={commit} />
  <script is:inline>
    (function () {
      var root = document.documentElement, key = 'mantine-color-scheme-value', mq = matchMedia('(prefers-color-scheme: dark)');
      function stored() { try { return localStorage.getItem(key); } catch (e) { return null; } }
      document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
        var next = root.getAttribute('data-mantine-color-scheme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-mantine-color-scheme', next);
        try { localStorage.setItem(key, next); } catch (e) {}
      });
      var status = document.querySelector('[data-copy-status]');
      document.querySelectorAll('[data-copy]').forEach(function (b) {
        b.addEventListener('click', function () {
          navigator.clipboard.writeText(b.getAttribute('data-copy')).then(function () {
            b.classList.add('copied'); status.textContent = 'Copied';
            setTimeout(function () { b.classList.remove('copied'); status.textContent = ''; }, 1500);
          });
        });
      });
      mq.addEventListener('change', function () {
        var v = stored();
        if (v !== 'light' && v !== 'dark') root.setAttribute('data-mantine-color-scheme', mq.matches ? 'dark' : 'light');
      });
    })();
  </script>
</body>
</html>
