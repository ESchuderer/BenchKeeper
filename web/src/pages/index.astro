---
import '@mantine/core/styles.css';
import '../styles/global.css';
import Page from '../components/Page';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en" data-mantine-color-scheme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>BenchKeeper</title>
  <meta name="description" content="BenchKeeper keeps your AI coding agents' workbench in order: Claude Code or Codex runs its skills to install and check rules, skills and tools at pinned versions, machine-wide and per repository.">
  <link rel="icon" href={`${base}/logo.svg`} type="image/svg+xml">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
  <script is:inline>
    (function () {
      var v = null;
      try { v = localStorage.getItem('mantine-color-scheme-value'); } catch (e) {}
      var s = v === 'light' || v === 'dark' ? v : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-mantine-color-scheme', s);
    })();
  </script>
</head>
<body>
  <Page base={base} />
  <script is:inline>
    (function () {
      var root = document.documentElement, key = 'mantine-color-scheme-value', mq = matchMedia('(prefers-color-scheme: dark)');
      function stored() { try { return localStorage.getItem(key); } catch (e) { return null; } }
      document.querySelector('[data-theme-toggle]').addEventListener('click', function () {
        var next = root.getAttribute('data-mantine-color-scheme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-mantine-color-scheme', next);
        try { localStorage.setItem(key, next); } catch (e) {}
      });
      mq.addEventListener('change', function () {
        var v = stored();
        if (v !== 'light' && v !== 'dark') root.setAttribute('data-mantine-color-scheme', mq.matches ? 'dark' : 'light');
      });
    })();
  </script>
</body>
</html>
