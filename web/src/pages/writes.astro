---
import SiteLayout from '../layouts/SiteLayout.astro';
import WritesPage from '../components/WritesPage';
import { SLUG } from '../lib/repo-facts';
import * as setup from '../../../docs/setup.md';
import * as security from '../../../docs/security.md';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// One `## ` section of a rendered doc, without its heading when bare; a missing section fails the build.
const section = async (doc: typeof setup, file: string, id: string, bare = false) => {
  const html = await doc.compiledContent();
  const m = new RegExp(`(<h2 id="${id}">.*?</h2>)([\\s\\S]*?)(?=<h2 |$)`).exec(html);
  if (!m) throw new Error(`docs/${file} has no section #${id}`);
  // Relative links of the doc point at the file on GitHub.
  return (bare ? m[2] : m[0]).replace(/href="(?!https?:|#)([^"]*)"/g, (_, h) => { const u = new URL(h, 'https://x/docs/'); return `href="https://github.com/${SLUG}/blob/main${u.pathname}${u.hash}"`; });
};
const html = [
  await section(setup, 'setup.md', 'what-the-app-writes-and-what-it-never-does', true),
  await section(security, 'security.md', 'what-the-app-writes'),
  await section(security, 'security.md', 'what-the-app-never-does'),
].join('');
---
<SiteLayout title="What the app writes, BenchKeeper"
  description="What the BenchKeeper app writes to your machine and repositories, where each write is confined, and what it never does, from docs/setup.md and docs/security.md.">
  <WritesPage base={base} html={html} />
  <style is:global>
    .doc table { width: 100%; table-layout: fixed; border-collapse: collapse; overflow-wrap: anywhere; font-size: var(--mantine-font-size-sm); }
    .doc th, .doc td { border: 1px solid var(--mantine-color-default-border); padding: 8px; text-align: left; vertical-align: top; }
    /* long paths in the narrow table columns may break */
    .doc td code { white-space: normal; }
    .doc code { font-size: 0.9em; }
    .doc h2 { margin-top: 2em; }
  </style>
</SiteLayout>
